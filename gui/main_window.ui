  <property name="styleSheet">
   <string notr="true">
QFrame#sidebar {
    background-color: #2c3e50;
}
QFrame#sidebar QLabel {
    color: #ecf0f1;
    padding-left: 8px;
}
QFrame#sidebar QPushButton {
    background-color: transparent;
    color: #bdc3c7;
    border: none;
    text-align: left;
    padding: 12px 20px;
    font-size: 13px;
}
QFrame#sidebar QPushButton:hover {
    background-color: #34495e;
    color: white;
}
QFrame#sidebar QPushButton:disabled {
    color: #4a5568;
}
QPushButton#btn_video, QPushButton#btn_camera {
    background-color: #2980b9;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 13px;
    border-radius: 4px;
    min-height: 36px;
}
QPushButton#btn_video:hover, QPushButton#btn_camera:hover {
    background-color: #3498db;
}
QPushButton#btn_stop {
    background-color: #c0392b;
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 4px;
    font-weight: bold;
}
QPushButton#btn_stop:hover {
    background-color: #e74c3c;
}
QPushButton#btn_new_detection {
    background-color: #27ae60;
    color: white;
    border: none;
    padding: 10px 28px;
    font-size: 13px;
    border-radius: 4px;
}
QPushButton#btn_new_detection:hover {
    background-color: #2ecc71;
}
QPushButton#btn_confirm_calib {
    background-color: #27ae60;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
}
QPushButton#btn_confirm_calib:hover {
    background-color: #2ecc71;
}
QPushButton#btn_open_excel, QPushButton#btn_open_video1,
QPushButton#btn_open_video2, QPushButton#btn_open_folder {
    background-color: #ecf0f1;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 4px 10px;
    border-radius: 3px;
    min-width: 56px;
}
QPushButton#btn_open_excel:hover, QPushButton#btn_open_video1:hover,
QPushButton#btn_open_video2:hover, QPushButton#btn_open_folder:hover {
    background-color: #d5dbdb;
}
QLabel#lbl_video_feed, QLabel#lbl_frame_display,
QLabel#lbl_trajectory_img, QLabel#lbl_heatmap_img {
    background-color: #1a1a2e;
    color: #636e72;
    border: 2px solid #2c3e50;
    border-radius: 4px;
}
QLabel#lbl_app_title {
    font-size: 15px;
    font-weight: bold;
    padding: 18px 8px 4px 12px;
    color: white;
}
QLabel#lbl_model_status {
    font-size: 10px;
    color: #2ecc71;
    padding: 0px 8px 14px 12px;
}
QLabel#lbl_version {
    font-size: 10px;
    color: #636e72;
    padding: 4px 8px;
}
QLabel#lbl_px_cm_ratio {
    font-weight: bold;
    color: #2980b9;
    font-size: 12px;
}
QLabel#lbl_elapsed_time {
    font-size: 15px;
    font-weight: bold;
    color: #2c3e50;
    padding: 0px 8px;
}
QTextEdit#log_detection {
    background-color: #1e272e;
    color: #dfe6e9;
    font-family: Consolas, monospace;
    font-size: 11px;
    border: none;
}
QLabel#lbl_calib_instructions {
    color: #935116;
    background-color: #fef9e7;
    padding: 8px 12px;
    border-left: 4px solid #e67e22;
    border-radius: 2px;
    font-size: 12px;
}
QPushButton#btn_back_calib, QPushButton#btn_back_detection {
    background-color: transparent;
    color: #7f8c8d;
    border: 1px solid #bdc3c7;
    padding: 4px 12px;
    border-radius: 3px;
    font-size: 12px;
}
QPushButton#btn_back_calib:hover, QPushButton#btn_back_detection:hover {
    background-color: #ecf0f1;
    color: #2c3e50;
}
QPushButton#btn_import_coords, QPushButton#btn_select_output, QPushButton#btn_browse_results {
    background-color: #ecf0f1;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 4px 10px;
    border-radius: 3px;
}
QPushButton#btn_import_coords:hover, QPushButton#btn_select_output:hover, QPushButton#btn_browse_results:hover {
    background-color: #d5dbdb;
}
QListWidget#list_result_runs {
    border: 1px solid #bdc3c7;
    border-radius: 3px;
    font-size: 12px;
}
QListWidget#list_result_runs::item:selected {
    background-color: #2980b9;
    color: white;
}
